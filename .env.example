# Wachtwoord voor de editor op /beheer (verplicht om te kunnen opslaan)
BEHEER_WACHTWOORD=

# Wordt automatisch gezet als je in Vercel een Blob-opslag koppelt (Storage > Create > Blob).
# Vercel zet daarbij BLOB_READ_WRITE_TOKEN of BLOB_STORE_ID (nieuwe koppelingen loggen in via OIDC). Een van de twee is genoeg.
# Lokaal alleen nodig als je het opslaan wilt testen.
BLOB_READ_WRITE_TOKEN=
